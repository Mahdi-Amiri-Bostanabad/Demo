# Database (required)
MONGODB_URI="<your-mongodb-uri>"
DATABASE_NAME="agentic_predictive_maintenance"

# Optional external Leafy Factory simulator
# The UNS experience remains fully functional with its local browser simulation.
FACTORY_SIMULATOR_API_URL="http://localhost:3007"

# Optional architecture-modal links for the deployed Leafy Factory systems.
# Leave any of these unset to hide that link. The page still loads.
# LEAFY_ERP_URL="https://factory-simulator-erp.industrysolutions.staging.corp.mongodb.com/"
# LEAFY_MES_URL="https://factory-simulator-mes.industrysolutions.staging.corp.mongodb.com/?orgId=1"
# LEAFY_SCADA_URL="https://factory-simulator.industrysolutions.staging.corp.mongodb.com/scada"

# AvalAI (required only when CHAT_PROVIDER or EMBEDDING_PROVIDER is avalai)
# AVALAI_API_KEY="<your-avalai-api-key>"
# Example models: COMPLETION_MODEL="claude-haiku-5-5", EMBEDDING_MODEL="text-embedding-3-small"

# Chat completions (choose one: bedrock, grove or avalai)
CHAT_PROVIDER="bedrock"
# Model ID supported by the selected chat provider
COMPLETION_MODEL="us.anthropic.claude-haiku-4-5-20251001-v1:0"
# Required only when CHAT_PROVIDER=grove
GROVE_API_KEY="<your-grove-api-key>"

# Embeddings (choose one: bedrock, voyage or avalai)
EMBEDDING_PROVIDER="voyage"
# Model ID and output dimensions for the selected embedding provider
EMBEDDING_MODEL="voyage-4"
EMBEDDING_DIMENSIONS="1024"
# Required only when EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY="<your-voyage-api-key>"

# AWS Bedrock (required only when CHAT_PROVIDER or EMBEDDING_PROVIDER is bedrock)
AWS_REGION="us-east-1"
# Optional when credentials are supplied by the default AWS credential chain
AWS_PROFILE="default"